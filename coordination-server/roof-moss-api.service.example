[Unit]
Description=SleepyAddon Roof Moss Coordination API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roof-moss
Group=roof-moss
WorkingDirectory=/opt/roof-moss-api
EnvironmentFile=/etc/roof-moss-api.env
ExecStart=/usr/bin/python3 /opt/roof-moss-api/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/roof-moss

[Install]
WantedBy=multi-user.target
